    },
    "./bundle/components/SliderInput": {
      "types": "./dist/components/SliderInput.d.ts",
      "default": "./dist/bundle/components/SliderInput.js"
    },
    "./bundle/components/Tabs": "./dist/bundle/components/Tabs.js",
    "./bundle/components/TextInput": {
      "types": "./dist/components/TextInput.d.ts",
      "default": "./dist/bundle/components/TextInput.js"
    },
    "./bundle/minimal": {
      "types": "./dist/index.d.ts",
      "default": "./dist/bundle/minimal/index.js"
    },
    "./bundle/minimal/components/CheckboxInput": {
      "types": "./dist/components/CheckboxInput.d.ts",
      "default": "./dist/bundle/minimal/components/CheckboxInput.js"
    },
    "./bundle/minimal/components/CircularSpinner": {
      "types": "./dist/components/CircularSpinner.d.ts",
      "default": "./dist/bundle/minimal/components/CircularSpinner.js"
    },
    "./bundle/minimal/components/FileInput": {
      "types": "./dist/components/FileInput.d.ts",
      "default": "./dist/bundle/minimal/components/FileInput.js"
    },
    "./bundle/minimal/components/GenericAnimate": {
      "types": "./dist/components/GenericAnimate.d.ts",
      "default": "./dist/bundle/minimal/components/GenericAnimate.js"
    },
    "./bundle/minimal/components/GenericInputs": {
