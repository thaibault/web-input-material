{
  "name": "web-input-material",
  "version": "0.0.510",
  "description": "Reusable material design based input field with support for (richt-)text, code, selections, numbers, dates and so on.",
  "keywords": [
    "form-field",
    "input",
    "number-input",
    "rich-text",
    "text",
    "webcomponent",
    "component"
  ],
  "homepage": "https://torben.website/web-input-material",
  "bugs": {
    "email": "info@torben.website",
    "url": "https://github.com/thaibault/web-input-material/issues"
  },
  "license": "CC-BY-3.0",
  "author": {
    "email": "info@torben.website",
    "name": "Torben Sickert",
    "url": "https://torben.website"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thaibault/web-input-material"
  },
  "type": "module",
  "files": [
    "components",
    "index.bundle.js",
    "index.d.ts",
    "index.js",
    "type.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "yarn build:types; yarn build:plain; yarn build:bundle; yarn build:bundle:minimal",
    "build:bundle": "weboptimizer build '{__reference__: \"target:bundle\"}'",
    "build:bundle:minimal": "weboptimizer build '{__reference__: [\"target:bundle\", \"target:minimal\", \"target:bundle:minimal\"]}'",
    "build:bundle:stats": "weboptimizer build --json /tmp/stat.json '{__reference__: \"target:bundle\"}' && echo 'Results successfully written to \"/tmp/stat.json\".'",
    "build:plain": "weboptimizer build",
    "build:types": "weboptimizer build:types",
    "check": "yarn check:types; yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "serve": "weboptimizer serve",
    "serve:minimal": "weboptimizer serve '{__reference__: \"target:minimal\"}'",
    "start": "yarn serve",
    "test": "yarn clear && weboptimizer test '{__reference__: \"target:minimal\"}'",
    "test:browser": "yarn clear && weboptimizer test:browser '{__reference__: \"target:minimal\"}'",
    "test:coverage": "yarn clear && weboptimizer test:coverage '{__reference__: \"target:minimal\"}'",
    "test:coverage:report": "yarn clear && weboptimizer test:coverage:report '{__reference__: \"target:minimal\"}'",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-input-material": "^0.0.832",
    "react-transition-group": "^4.4.5",
    "web-component-wrapper": "^0.0.611"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-transform-proto-to-assign": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@eslint/js": "^10.0.1",
    "@rmwc/card": "^14.3.5",
    "@rmwc/checkbox": "^14.3.5",
    "@rmwc/circular-progress": "^14.3.5",
    "@rmwc/formfield": "^14.3.5",
    "@rmwc/icon": "^14.3.5",
    "@rmwc/icon-button": "^14.3.5",
    "@rmwc/select": "^14.3.5",
    "@rmwc/slider": "patch:@rmwc/slider@npm%3A14.3.5#~/.yarn/patches/@rmwc-slider-npm-14.3.5-c8fe4ac3a5.patch",
    "@rmwc/tabs": "^14.3.5",
    "@rmwc/textfield": "^14.3.5",
    "@rmwc/theme": "^14.3.5",
    "@rmwc/tooltip": "^14.3.5",
    "@rmwc/touch-target": "^14.3.5",
    "@rmwc/typography": "^14.3.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tiptap/core": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@types/ejs": "^3.1.5",
    "@types/html-minifier": "^4.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-transition-group": "^4.4.12",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "blob-util": "^2.0.2",
    "clientnode": "^4.0.1484",
    "eslint": "^10.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^64.2.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jsdoc": "^4.0.5",
    "material-components-web": "^14.0.0",
    "material-icons": "^1.13.14",
    "react-generic-animate": "^0.0.130",
    "react-generic-dummy": "^0.0.134",
    "react-generic-tools": "^0.0.124",
    "react-useanimations": "^2.10.0",
    "spark-md5": "^3.0.2",
    "style-loader": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript-eslint": "^8.67.0",
    "web-documentation": "^1.0.49",
    "weboptimizer": "^4.0.55",
    "webpack-dev-server": "^6.0.0"
  },
  "peerDependencies": {
    "clientnode": "*"
  },
  "resolutions": {
    "@rmwc/ripple@npm:14.3.5": "patch:@rmwc/ripple@npm%3A14.3.5#~/.yarn/patches/@rmwc-ripple-npm-14.3.5-9657693602.patch",
    "colors": "1.4.0",
    "globals@npm:^14.0.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^9.18.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "tagline": "Do not refactor input fields anymore.<!--deDE:Nie wieder Eingabefelder anpassen.-->",
    "trackingCode": "TODO"
  },
  "webOptimizer": {
    "commandLine": {
      "test": {
        "environments": [
          "jsdom"
        ]
      }
    },
    "development": {
      "server": {
        "port": 8081,
        "proxy": [
          {
            "changeOrigin": true,
            "context": [
              "/placeholder"
            ],
            "pathRewrite": {
              "^/placeholder": ""
            },
            "secure": false,
            "target": "https://placehold.co"
          }
        ]
      }
    },
    "generic": {
      "entry": {
        "./components/CircularSpinner": "./components/CircularSpinner",
        "./components/FileInput": "./components/FileInput",
        "./components/GenericAnimate": "./components/GenericAnimate",
        "./components/TextInput": "./components/TextInput",
        "./components/GenericInputs": "./components/GenericInputs",
        "./components/Tabs": [
          "./components/TabItem",
          "./components/TabBar"
        ],
        "./components/CheckboxInput": "./components/CheckboxInput",
        "./components/SliderInput": "./components/SliderInput",
        "index": "./index"
      },
      "supportedBrowsers": [
        "IE >= 11",
        "last 2 versions",
        "> 5%"
      ]
    },
    "injection": {
      "entry": {
        "__evaluate__": "2 < self.givenCommandLineArguments.length && self.givenCommandLineArguments[2] === 'serve' ? {clientnode: 'clientnode', index: './index'} : 2 < self.givenCommandLineArguments.length && self.givenCommandLineArguments[2].startsWith('test') ? {testBundle: './test'} : self.generic.entry"
      }
    },
    "module": {
      "aliases": {
        "#": "Not yet working since it is hidden by parents having overflow hidden.",
        "@rmwc/tooltip": "react-input-material/shims/optionals"
      },
      "enforceDeduplication": true,
      "html": {
        "options": {
          "sources": {
            "urlFilter": {
              "#": "TODO why?",
              "__evaluate__": "() => false"
            }
          }
        }
      },
      "optimizer": {
        "terser": {
          "terserOptions": {
            "compress": {
              "#": "To provide a logging output we need to exclude this feature.",
              "drop_console": {
                "__evaluate__": "false"
              },
              "drop_debugger": {
                "__evaluate__": "false"
              }
            }
          }
        }
      }
    },
    "path": {
      "source": {
        "base": "src/"
      },
      "target": {
        "base": "dist/"
      }
    },
    "target:bundle": {
      "inPlace": {
        "externalLibrary": {
          "dynamic": true,
          "normal": true
        }
      },
      "path": {
        "target": {
          "base": "dist/bundle/"
        }
      }
    },
    "target:bundle:minimal": {
      "path": {
        "target": {
          "base": "dist/bundle/minimal/"
        }
      }
    },
    "target:minimal": {
      "module": {
        "aliases": {
          "#": "Remove unneeded optional dependencies.",
          "@codemirror/autocomplete": "react-input-material/shims/optionals",
          "@codemirror/commands": "react-input-material/shims/optionals",
          "@codemirror/lang-css": "react-input-material/shims/optionals",
          "@codemirror/lang-javascript": "react-input-material/shims/optionals",
          "@codemirror/language": "react-input-material/shims/optionals",
          "@codemirror/lint": "react-input-material/shims/optionals",
          "@codemirror/search": "react-input-material/shims/optionals",
          "@codemirror/state": "react-input-material/shims/optionals",
          "@codemirror/view": "react-input-material/shims/optionals",
          "@rmwc/tooltip": "react-input-material/shims/optionals",
          "@tiptap/core$": "react-input-material/shims/optionals",
          "@tiptap/extensions$": "react-input-material/shims/optionals",
          "@tiptap/react$": "react-input-material/shims/optionals",
          "@tiptap/starter-kit$": "react-input-material/shims/optionals",
          "react-useanimations$": "react-generic-dummy",
          "react-useanimations/lib/lock$": "react-generic-dummy",
          "react-useanimations/lib/plusToX$": "react-generic-dummy"
        }
      }
    },
    "test": {
      "injection": {
        "external": {
          "implicit": {
            "pattern": {
              "exclude": {
                "__append__": {
                  "__evaluate__": "/(?:^|\\/)((react-input-material)|(web-component-wrapper))(?:$|\\/)/"
                }
              }
            }
          }
        }
      }
    },
    "webpack": {
      "snapshot": {
        "unmanagedPaths": [
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]clientnode[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]react-generic-(animate|dummy|tools)[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]react-input-material[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]web-component-wrapper[\\/]/"
          }
        ]
      },
      "watchOptions": {
        "ignored": {
          "__remove__": "**/node_modules"
        }
      }
    }
  },
  "packageManager": "yarn@4.14.1+sha512.64df448055b2d37ba269d7db535a469b8da93f8ef1140c25fd7a83c00a8fbaacb214ca0e02553b92a2c54cef78bb67d0b4817fab02001df0e24fac0faccc3b42"
}
