  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ],
    "tagline": "Do not refactor input fields anymore.<!--deDE:Nie wieder Eingabefelder anpassen.-->"
  },
  "webOptimizer": {
    "commandLine": {
      "test": {
        "environments": [
          "jsdom"
        ]
      }
    },
    "development": {
      "server": {
        "port": 8081,
        "proxy": [
          {
            "changeOrigin": true,
            "context": [
              "/placeholder"
            ],
            "pathRewrite": {
              "^/placeholder": ""
            },
            "secure": false,
            "target": "https://placehold.co"
          }
        ]
      }
    },
    "generic": {
      "entry": {
        "./components/CircularSpinner": "./components/CircularSpinner",
        "./components/FileInput": "./components/FileInput",
        "./components/GenericAnimate": "./components/GenericAnimate",
        "./components/TextInput": "./components/TextInput",
        "./components/GenericInputs": "./components/GenericInputs",
        "./components/IntervalInput": "./components/IntervalInput",
        "./components/Tabs": [
          "./components/TabItem",
          "./components/TabBar"
        ],
        "./components/CheckboxInput": "./components/CheckboxInput",
        "./components/SliderInput": "./components/SliderInput",
        "index": "./index"
      },
      "supportedBrowsers": [
        "IE >= 11",
        "last 2 versions",
        "> 5%"
      ]
    },
    "injection": {
      "entry": {
        "__evaluate__": "2 < self.givenCommandLineArguments.length && self.givenCommandLineArguments[2] === 'serve' ? {clientnode: 'clientnode', index: './index'} : 2 < self.givenCommandLineArguments.length && self.givenCommandLineArguments[2].startsWith('test') ? {testBundle: './test'} : self.generic.entry"
      }
    },
    "module": {
      "aliases": {
        "#": "Not yet working since it is hidden by parents having overflow hidden.",
        "@rmwc/tooltip": "react-input-material/shims/optionals"
      },
      "enforceDeduplication": true,
      "html": {
        "options": {
          "sources": {
            "urlFilter": {
              "#": "Do not process any referenced resource in HTML.",
              "__evaluate__": "() => false"
            }
          }
        }
      },
      "optimizer": {
        "#": "Let all serve entries share one module cache so the playground configures the same dependency instances (e.g. the clientnode logger) the components use.",
        "runtimeChunk": {
          "__evaluate__": "2 < self.givenCommandLineArguments.length && self.givenCommandLineArguments[2] === 'serve' ? 'single' : false"
        },
        "terser": {
          "terserOptions": {
            "compress": {
              "#": "To provide a logging output we need to exclude this feature.",
              "drop_console": {
                "__evaluate__": "false"
              },
              "drop_debugger": {
                "__evaluate__": "false"
              }
            }
          }
        }
      }
    },
    "path": {
      "source": {
        "base": "src/"
      },
      "target": {
        "base": "dist/"
      }
    },
    "target:bundle": {
      "inPlace": {
        "externalLibrary": {
          "dynamic": true,
          "normal": true
        }
      },
      "path": {
        "target": {
          "base": "dist/bundle/"
        }
      }
    },
    "target:bundle:minimal": {
      "path": {
        "target": {
          "base": "dist/bundle/minimal/"
        }
      }
    },
    "target:minimal": {
      "module": {
        "aliases": {
          "#": "Remove unneeded optional dependencies.",
          "@codemirror/autocomplete": "react-input-material/shims/optionals",
          "@codemirror/commands": "react-input-material/shims/optionals",
          "@codemirror/lang-css": "react-input-material/shims/optionals",
          "@codemirror/lang-javascript": "react-input-material/shims/optionals",
          "@codemirror/language": "react-input-material/shims/optionals",
          "@codemirror/lint": "react-input-material/shims/optionals",
          "@codemirror/search": "react-input-material/shims/optionals",
          "@codemirror/state": "react-input-material/shims/optionals",
          "@codemirror/view": "react-input-material/shims/optionals",
          "@rmwc/tooltip": "react-input-material/shims/optionals",
          "@tiptap/core$": "react-input-material/shims/optionals",
          "@tiptap/extensions$": "react-input-material/shims/optionals",
          "@tiptap/react$": "react-input-material/shims/optionals",
          "@tiptap/starter-kit$": "react-generic-dummy",
          "react-useanimations$": "react-generic-dummy",
          "react-useanimations/lib/lock$": "react-generic-dummy",
          "react-useanimations/lib/plusToX$": "react-generic-dummy"
        }
      }
    },
    "test": {
      "injection": {
        "external": {
          "implicit": {
            "pattern": {
              "exclude": {
                "__append__": {
                  "__evaluate__": "/(?:^|\\/)((react-input-material)|(web-component-wrapper))(?:$|\\/)/"
                }
              }
            }
          }
        }
      }
    },
    "webpack": {
      "snapshot": {
        "unmanagedPaths": [
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]clientnode[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]react-generic-(animate|dummy|tools)[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]react-input-material[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]web-component-wrapper[\\/]/"
          }
        ]
      },
      "watchOptions": {
        "ignored": {
          "__remove__": "**/node_modules"
        }
      }
    }
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
